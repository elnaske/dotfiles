# colors
config-file = ~/.cache/wal/ghostty.conf

# background
background-opacity = 0.8
background-blur = true

window-decoration = none

# disable ligatures
font-feature = -calt
font-feature = -liga
font-feature = -dlig

mouse-hide-while-typing

bell-features = no-audio
bell-features = no-attention
bell-features = no-title
